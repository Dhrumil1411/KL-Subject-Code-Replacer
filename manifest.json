{
  "manifest_version": 3,
  "name": "KL Subject Code Replacer",
  "version": "2.2.0",
  "description": "Replaces subject codes with full subject names, color-coded session badges, prominent classroom indicators, live class tracker, and live 85% attendance bunk calculator for KL University ERP.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://newerp.kluniversity.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://newerp.kluniversity.in/index.php?r=timetables%2Funiversitymasteracademictimetableview%2Findividualstudenttimetableget*",
        "https://newerp.kluniversity.in/index.php?r=timetables/universitymasteracademictimetableview/individualstudenttimetableget*",
        "https://newerp.kluniversity.in/index.php?r=*individualstudenttimetableget*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["subject_codes.json"],
      "matches": ["https://newerp.kluniversity.in/*"]
    }
  ]
}
